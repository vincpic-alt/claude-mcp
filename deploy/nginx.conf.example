# claude-mcp.callin.io — reverse proxy to the isolated MCP Node process on 127.0.0.1:3100
# Do not modify app.callin.io or api.callin.io server blocks unless required.
#
# After installing certificates (e.g. certbot):
#   sudo ln -s /etc/nginx/sites-available/claude-mcp.callin.io /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    server_name claude-mcp.callin.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name claude-mcp.callin.io;

    ssl_certificate     /etc/letsencrypt/live/claude-mcp.callin.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/claude-mcp.callin.io/privkey.pem;

    client_max_body_size 16k;

    # OAuth query strings can contain temporary codes/state — do not log requests.
    access_log off;
    error_log /var/log/nginx/claude-mcp.callin.io.error.log;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
