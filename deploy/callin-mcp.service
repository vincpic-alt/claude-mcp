[Unit]
Description=Callin MCP OAuth connector (isolated from Express API / LiveKit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=callin-mcp
Group=callin-mcp
WorkingDirectory=/opt/callin-mcp
EnvironmentFile=/etc/callin-mcp.env
ExecStart=/usr/bin/node /opt/callin-mcp/src/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/callin-mcp
# Prefer PM2 (Callin-MCP-production) if the host already runs ExpressJs-API-production via PM2.

[Install]
WantedBy=multi-user.target
