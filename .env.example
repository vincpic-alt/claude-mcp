# Callin MCP Connector — environment template
# Copy to .env and fill in real values. Never commit secrets.

NODE_ENV=production
HOST=127.0.0.1
PORT=3100

# Public origin of this MCP service (HTTPS, no trailing slash)
MCP_PUBLIC_URL=https://claude-mcp.callin.io
# Alias accepted: PUBLIC_BASE_URL

# Callin web app origin (consent UI lives here)
CALLIN_APP_ORIGIN=https://app.callin.io
# Alias accepted: CALLIN_APP_URL

# Optional reference to the existing Express API (MCP v1 reads Supabase directly)
CALLIN_API_URL=https://api.callin.io

# Supabase project (server-side only — never expose SERVICE_ROLE to browsers)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY

# SQLite grant/token store (use a private path in production)
MCP_DB_PATH=./data/oauth.sqlite

# Exact redirect URIs only — no wildcards. Claude hosted callback is required.
OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Token lifetimes (seconds)
OAUTH_ACCESS_TOKEN_TTL=900
OAUTH_REFRESH_TOKEN_TTL=2592000
OAUTH_GRANT_TTL=2592000
